<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D98282"
    android:backgroundTint="#ADE2F8"
    tools:context=".ShowAllLostAndFoundItems">


    <ListView
        android:id="@+id/ItemView"
        android:layout_width="381dp"
        android:layout_height="534dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/LostFoundItemsTextView"
        app:layout_constraintVertical_bias="0.624" />

    <TextView
        android:id="@+id/LostFoundItemsTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="77dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="77dp"
        android:layout_marginBottom="16dp"
        android:text="Lost + Found Items"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/HomeButton1"
        android:layout_width="130dp"
        android:layout_height="53dp"
        android:layout_marginStart="52dp"
        android:layout_marginTop="17dp"
        android:layout_marginEnd="46dp"
        android:layout_marginBottom="7dp"
        android:backgroundTint="#BF2121"
        android:onClick="homeClick1"
        android:text="Home"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/Addevent3"
        app:layout_constraintStart_toStartOf="parent"
        />

    <Button
        android:id="@+id/Addevent3"
        android:layout_width="130dp"
        android:layout_height="53dp"
        android:layout_marginStart="46dp"
        android:layout_marginTop="17dp"
        android:layout_marginEnd="53dp"
        android:layout_marginBottom="7dp"
        android:backgroundTint="#F44336"
        android:onClick="addItemClick"
        android:text="Add Lost Item"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/HomeButton1"
         />

    <SearchView
        android:id="@+id/SearchView"
        android:layout_width="409dp"
        android:layout_height="35dp"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:layout_marginBottom="9dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/LostFoundItemsTextView"
        android:queryHint="Search"
        android:iconifiedByDefault="false"/>

    <Button
        android:id="@+id/Electronics"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="4dp"
        android:backgroundTint="#009688"
        android:text="Electronics"
        android:textSize="11sp"
        app:layout_constraintBottom_toTopOf="@+id/ItemView"
        app:layout_constraintEnd_toStartOf="@+id/Pets"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/SearchView"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/Pets"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="4dp"
        android:backgroundTint="#2196F3"
        android:text="Pets"
        android:textSize="11sp"
        app:layout_constraintBottom_toTopOf="@+id/ItemView"
        app:layout_constraintEnd_toStartOf="@+id/Wallets"
        app:layout_constraintStart_toEndOf="@+id/Electronics"
        app:layout_constraintTop_toBottomOf="@+id/SearchView"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/Wallets"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="4dp"
        android:backgroundTint="#00BCD4"
        android:text="Wallets"
        android:textSize="11sp"
        app:layout_constraintBottom_toTopOf="@+id/ItemView"
        app:layout_constraintEnd_toStartOf="@+id/Other"
        app:layout_constraintStart_toEndOf="@+id/Pets"
        app:layout_constraintTop_toBottomOf="@+id/SearchView"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/Other"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="1dp"
        android:layout_marginBottom="4dp"
        android:backgroundTint="#FF9800"
        android:text="Other"
        android:textSize="11sp"
        app:layout_constraintBottom_toTopOf="@+id/ItemView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/Wallets"
        app:layout_constraintTop_toBottomOf="@+id/SearchView"
        app:layout_constraintVertical_bias="1.0" />


</androidx.constraintlayout.widget.ConstraintLayout>